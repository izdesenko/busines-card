# Относительный путь по умолчанию работает вместе с прокси из vite.config.ts.
# Для продакшен-сборки укажите абсолютный адрес бэкенда, например:
# VITE_GRAPHQL_URL=https://api.example.com/graphql
VITE_GRAPHQL_URL=/graphql

# Название сайта в <title> и <meta>
VITE_SITE_TITLE="User — Software Developer"
