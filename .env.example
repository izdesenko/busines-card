# --- База данных ---
DATABASE_URL="file:./database.sqlite"

# --- Сервер ---
PORT=3000

# --- Сессии / cookies (замените на длинные случайные строки) ---
SESSION_SECRET=change_me_super_secret
ADMIN_COOKIE_SECRET=change_me_admin_cookie_secret

# --- Администратор по умолчанию (создаётся автоматически при первом старте, если таблица User пуста) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# --- Telegram-бот для формы обратной связи ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# chat_id вашего Telegram-аккаунта или канала/чата (например, узнать через @userinfobot)
TELEGRAM_CHAT_ID=
