# --- База данных ---
DATABASE_URL="file:./database.sqlite"

# --- Сервер ---
PORT=3000
# Разрешённые origins для CORS (через запятую), или "*" для всех
CORS_ORIGIN=http://localhost:5173

# --- Администратор по умолчанию (создаётся автоматически при первом старте, если таблица User пуста) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# --- Сессии / cookies ---
SESSION_SECRET=change_me_super_secret
ADMIN_COOKIE_SECRET=change_me_admin_cookie_secret
# Путь к админ-панели (по умолчанию /admin)
ADMIN_ROOT_PATH=/admin

# --- Пароли / hash ---
# rounds для bcrypt (по умолчанию 10)
BCRYPT_SALT_ROUNDS=10

# --- Telegram-бот для формы обратной связи ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# chat_id вашего Telegram-аккаунта или канала/чата (например, узнать через @userinfobot)
TELEGRAM_CHAT_ID=

# --- Дефолтные контакты (опционально, заполняются при первом старте, если таблица Contact пуста) ---
# Пример формата:
# DEFAULT_CONTACTS=[{"type":"telegram","label":"Telegram","value":"@username","url":"https://t.me/username","order":1}]
DEFAULT_CONTACTS=
