{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "extends": "//",
  "formatter": { "formatWithErrors": true },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "off",
        "useNamingConvention": "off"
      }
    }
  }
}
